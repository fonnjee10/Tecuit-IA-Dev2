# ═══════════════════════════════════════════════
#  Tecuit IA v2 — Configuration
#  Copiez en ".env" et remplissez vos valeurs.
#  Ce fichier n'est JAMAIS exposé au navigateur.
# ═══════════════════════════════════════════════

# Port du serveur Node.js
PORT=3000

# URL de votre backend LLM (Hermes via ngrok, Ollama, LM Studio…)
HERMES_URL=https://zenkaritecuitai.ngrok.app

# Kiwix — Wikipedia local
KIWIX_URL=http://localhost:8080
# Laisser vide = auto-détection depuis le catalogue Kiwix
KIWIX_BOOK_ID=

# Piper TTS — laisser vide pour utiliser la voix navigateur (fallback)
# Exemple Linux : ./piper/piper
# Exemple Windows : .\piper\piper.exe
PIPER_BIN=
PIPER_VOICE=./voices/fr_FR-upmc-pierre-medium.onnx
